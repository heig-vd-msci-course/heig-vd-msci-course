{
	"name": "HEIG-VD MSCI Course Development Container",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",

	// Forward Zensical dev server port to host
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "Zensical Dev Server",
			"onAutoForward": "openBrowser"
		}
	},

	// Execute the post-create.sh script once the container is created
	"postCreateCommand": ".devcontainer/post-create.sh",

	// Start the dev server when the container starts (optional - can be manual)
	// "postStartCommand": "source .venv/bin/activate && zensical serve",

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.terminal.activateEnvironment": true,
				"terminal.integrated.defaultProfile.linux": "bash",
				"files.associations": {
					"*.md": "markdown"
				},
				"editor.formatOnSave": true,
				"editor.wordWrap": "on"
			},
			"extensions": [
				"ms-python.python",
				"yzhang.markdown-all-in-one",
				"bierner.markdown-preview-github-styles",
				"DavidAnson.vscode-markdownlint",
				"marp-team.marp-vscode"
			]
		}
	}
}
